<!-- MTG Token Spawner (Bitterblossom) — Object UI

     Rows are injected by the Lua side as absolutely-positioned children of
     #tokenPanel. The filter row, quick-spawn row, and pager are static
     here. All use symmetric X offsets so a mirrored panel rotation only
     reverses left-right order (cosmetic), never hides them.

     Layout budget (top-anchored, offsetXY Y grows downward):
       search  -10   filter -50   quick-spawn -86   status -122
       rows start at ROW_Y0 (-150 in the Lua), 6 rows, step 44
       pager pinned to the lower corners
     If a row overlaps or a label clips, tune these + the Lua ROW_* consts.

     position/rotation/scale below are Brad's tuned values. -->

<Button id="toggleBtn" onClick="onTogglePanel"
        position="0 0 -25" rotation="0 0 180" scale="1 1 1"
        width="170" height="60" fontSize="28"
        color="#333344" textColor="#ffffbb">Tokens</Button>

<Panel id="tokenPanel" active="false"
       position="0 420 -5" rotation="0 0 180" scale="1 1 1"
       width="350" height="630" color="#1b1b1bF2">

  <InputField id="searchInput"
              onValueChanged="onSearchInput"
              rectAlignment="UpperCenter" offsetXY="0 -10"
              width="330" height="36" fontSize="14"
              placeholder="Search tokens…" />

  <!-- Category filter row (5 buttons). Variable widths packed across the
       panel so "Emblems" fits; flt_all starts highlighted. 4-state colors
       so the pressed tint doesn't darken to black. -->
  <Button id="flt_all"     onClick="onFilter" rectAlignment="UpperCenter"
          offsetXY="-142 -50" width="46" height="30" fontSize="13"
          colors="#5B21B6|#6d34d6|#4a1a9c|#5B21B6" textColor="#ffffff">All</Button>
  <Button id="flt_tokens"  onClick="onFilter" rectAlignment="UpperCenter"
          offsetXY="-83 -50" width="64" height="30" fontSize="13"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">Tokens</Button>
  <Button id="flt_emblems" onClick="onFilter" rectAlignment="UpperCenter"
          offsetXY="-9 -50" width="76" height="30" fontSize="13"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">Emblems</Button>
  <Button id="flt_dungeon" onClick="onFilter" rectAlignment="UpperCenter"
          offsetXY="67 -50" width="68" height="30" fontSize="13"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">Dungeon</Button>
  <Button id="flt_helper"  onClick="onFilter" rectAlignment="UpperCenter"
          offsetXY="135 -50" width="60" height="30" fontSize="13"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">Helper</Button>

<Text id="status"
        rectAlignment="UpperCenter" offsetXY="0 -86"
        width="330" height="18" fontSize="12"
        color="#bbbbbb" alignment="MiddleLeft">Loading…</Text>

  <!-- Result rows (static). Each row is a click Button + a Text overlay
       carrying the label — setValue populates <Text> reliably but not a
       Button label. row{i}txt is the label; row{i} is the click target.
       row count == PAGE_SIZE; offsets follow ROW_Y0 -150 / ROW_STEP 44. -->
  <Button id="row1" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -114" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row1txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -114" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row2" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -158" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row2txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -158" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row3" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -202" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row3txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -202" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row4" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -246" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row4txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -246" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row5" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -290" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row5txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -290" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row6" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -334" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row6txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -334" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row7" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -378" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row7txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -378" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>
  <Button id="row8" onClick="onResultClick" rectAlignment="UpperCenter"
          offsetXY="0 -422" width="326" height="42"
          colors="#333333|#4a4a4a|#262626|#333333"></Button>
  <Text id="row8txt" raycastTarget="false" rectAlignment="UpperCenter"
        offsetXY="0 -422" width="310" height="42" fontSize="13"
        alignment="MiddleLeft" color="#ffffff"></Text>

  <Button id="prevBtn" onClick="onPrevPage"
          rectAlignment="LowerLeft" offsetXY="12 12"
          width="150" height="34" fontSize="16"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">◄ Prev</Button>
  <Button id="nextBtn" onClick="onNextPage"
          rectAlignment="LowerRight" offsetXY="-12 12"
          width="150" height="34" fontSize="16"
          colors="#333344|#404058|#2a2a38|#333344" textColor="#ffffff">Next ►</Button>

</Panel>

<!-- Quick-spawn panel: floats above the tile, independent of the search
     panel. Position/rotation are Brad-tunable; rotation matches tokenPanel
     so text/icons sit upright on the tile. active="true" = always shown. -->
<Panel id="quickPanel" active="false"
       position="0 -140 -5" rotation="0 0 180" scale="1 1 1"
       width="350" height="64" color="#1b1b1bF2">
  <!-- Quick-spawn row (6 icon buttons). Button takes the click; the Image
       overlay (raycast off) draws the icon on top. Icons are registered
       as custom UI assets by the Lua side (registerIcons). -->
  <Button id="qs_treasure" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="-135 -7" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_treasure" image="ic_treasure" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="-135 2" width="42" height="28" />
  <Button id="qs_monarch" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="-81 -7" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_monarch" image="ic_monarch" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="-81 2" width="42" height="28" />
  <Button id="qs_clue" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="-27 -7" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_clue" image="ic_clue" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="-27 2" width="42" height="28" />
  <Button id="qs_food" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="27 -7" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_food" image="ic_food" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="27 2" width="42" height="28" />
  <Button id="qs_map" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="81 -7" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_map" image="ic_map" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="81 2" width="42" height="28" />
  <Button id="qs_blood" onClick="onQuickSpawn" rectAlignment="UpperCenter"
          offsetXY="135 -5" width="52" height="48"
          colors="#2a2a2a|#454545|#1a1a1a|#2a2a2a" textColor="#2a2a2a"></Button>
  <Image id="qsi_blood" image="ic_blood" raycastTarget="false" preserveAspect="true"
         rectAlignment="MiddleCenter" offsetXY="135 2" width="42" height="28" />

  </Panel>
